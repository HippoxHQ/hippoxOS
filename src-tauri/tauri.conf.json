            {
              "identifier": "fs:allow-log-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-picture-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-picture-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-public-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-public-write-recursive",
              "allow": [{ "path": "**" }]
