              "identifier": "fs:allow-home-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-localdata-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-localdata-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-log-write",
