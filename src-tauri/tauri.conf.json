            {
              "identifier": "fs:allow-cache-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-config-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-config-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-data-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-data-write-recursive",
              "allow": [{ "path": "**" }]
