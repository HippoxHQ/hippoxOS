{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HippoxOS",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HippoxOS",
        "width": 1350,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 875,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-window",
          "description": "Main Window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:event:allow-emit-to",
            "core:window:allow-close",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-position",
            "core:window:allow-set-focus",
            "shell:allow-open",
            "autostart:allow-enable",
            "autostart:allow-disable",
            "autostart:allow-is-enabled",
            "dialog:allow-open",
            {
              "identifier": "fs:allow-read-dir",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-read-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-stat",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-exists",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-write-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-read-text-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-write-text-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-app-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-app-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-appcache-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-appcache-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-appconfig-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-appconfig-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-appdata-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-appdata-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-applocaldata-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-applocaldata-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-applog-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-applog-write-recursive",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-audio-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-audio-write-recursive",
