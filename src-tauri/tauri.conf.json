              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-read-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-stat",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-exists",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-write-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-read-text-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-write-text-file",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-app-write",
              "allow": [{ "path": "**" }]
            },
            {
              "identifier": "fs:allow-app-write-recursive",
              "allow": [{ "path": "**" }]
            }
          ]
        },
        {
          "identifier": "submenu-window",
          "description": "Submenu Window",
          "windows": ["tray-submenu-window"],
          "permissions": [
            "core:default",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:event:allow-emit-to",
            "core:window:allow-close",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-position",
            "core:window:allow-set-focus",
            "shell:allow-open"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/ffmpeg-x86_64-pc-windows-msvc.exe",
      "bin/ffmpeg-x86_64-apple-darwin",
      "bin/ffmpeg-aarch64-apple-darwin",
      "bin/ffmpeg-x86_64-unknown-linux-gnu",
      "bin/ffprobe-x86_64-pc-windows-msvc.exe",
      "bin/ffprobe-x86_64-apple-darwin",
      "bin/ffprobe-aarch64-apple-darwin",
      "bin/ffprobe-x86_64-unknown-linux-gnu"
